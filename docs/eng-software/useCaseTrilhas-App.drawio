    <diagram id="uc-validations" name="Regras e Validações">
        <mxGraphModel dx="1074" dy="601" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="v0"/>
                <mxCell id="v1" parent="v0"/>
                <mxCell id="vTitle" value="Regras e Validações — Implementação Atual" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#17365D;" parent="v1" vertex="1">
                    <mxGeometry x="300" y="20" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vSubtitle" value="Regras extraídas dos DTOs, serviços e autorizações do backend." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontColor=#666666;" parent="v1" vertex="1">
                    <mxGeometry x="400" y="60" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vAuthHead" value="1. Cadastro e autenticação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontStyle=1;fontSize=16;align=left;spacingLeft=14;" parent="v1" vertex="1">
                    <mxGeometry x="90" y="120" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="vAuth" value="• Cadastro público permitido somente para ALUNO&lt;br&gt;• Nome, e-mail, senha, matrícula, curso, turma e campus obrigatórios&lt;br&gt;• E-mail deve possuir formato válido e não pode estar cadastrado&lt;br&gt;• Senha é armazenada com BCrypt&lt;br&gt;• Login exige credenciais válidas e e-mail confirmado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBFE;strokeColor=#5B9BD5;fontSize=13;align=left;verticalAlign=top;spacing=14;" parent="v1" vertex="1">
                    <mxGeometry x="90" y="175" width="440" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="vTokenHead" value="2. Confirmação de e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontStyle=1;fontSize=16;align=left;spacingLeft=14;" parent="v1" vertex="1">
                    <mxGeometry x="605" y="120" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="vToken" value="• O cadastro gera um token e envia o link por e-mail&lt;br&gt;• O token deve existir e não pode estar expirado&lt;br&gt;• Token inválido ou expirado redireciona com erro&lt;br&gt;• Token válido confirma a conta&lt;br&gt;• O token é excluído após confirmação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCF5;strokeColor=#70AD47;fontSize=13;align=left;verticalAlign=top;spacing=14;" parent="v1" vertex="1">
                    <mxGeometry x="605" y="175" width="440" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="vAccessHead" value="3. Sessão e autorização" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontStyle=1;fontSize=16;align=left;spacingLeft=14;" parent="v1" vertex="1">
                    <mxGeometry x="1120" y="120" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="vAccess" value="• Cadastro, login e confirmação são públicos&lt;br&gt;• Demais operações exigem JWT válido&lt;br&gt;• A API não mantém sessão no servidor&lt;br&gt;• Acesso por papel: STUDENT, TEACHER ou ADMIN&lt;br&gt;• Usuário comum só consulta/atualiza o próprio perfil&lt;br&gt;• ADMIN pode administrar usuários" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF2;strokeColor=#BF9000;fontSize=13;align=left;verticalAlign=top;spacing=14;" parent="v1" vertex="1">
                    <mxGeometry x="1120" y="175" width="440" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="vOwnerHead" value="4. Autoria e escopo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontStyle=1;fontSize=16;align=left;spacingLeft=14;" parent="v1" vertex="1">
                    <mxGeometry x="90" y="450" width="700" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="vOwner" value="• Professor só gerencia recursos vinculados à sua identidade&lt;br&gt;• Edição/exclusão de trilha exige autoria da trilha&lt;br&gt;• Módulo exige autoria da trilha relacionada&lt;br&gt;• Conteúdo exige autoria do módulo/trilha&lt;br&gt;• Exclusão de material e aviso exige autoria&lt;br&gt;• ADMIN é aceito pelas verificações de autoria&lt;br&gt;• Aluno só altera o próprio progresso e consulta avisos da própria turma" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F4;strokeColor=#ED7D31;fontSize=13;align=left;verticalAlign=top;spacing=14;" parent="v1" vertex="1">
                    <mxGeometry x="90" y="505" width="700" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="vContentHead" value="5. Conteúdo, materiais e avisos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontStyle=1;fontSize=16;align=left;spacingLeft=14;" parent="v1" vertex="1">
                    <mxGeometry x="860" y="450" width="700" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="vContent" value="• Trilha exige título, descrição, categoria e XP&lt;br&gt;• Módulo exige título, XP e trilha associada&lt;br&gt;• Conteúdo exige título, descrição, tipo, módulo e professor&lt;br&gt;• Material exige título, descrição e tipo; TEACHER submete&lt;br&gt;• Apenas ADMIN aprova ou rejeita materiais&lt;br&gt;• Consulta retorna somente materiais aprovados&lt;br&gt;• Aviso exige título, mensagem, tipo e autor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8FC;strokeColor=#8064A2;fontSize=13;align=left;verticalAlign=top;spacing=14;" parent="v1" vertex="1">
                    <mxGeometry x="860" y="505" width="700" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="vFlowTitle" value="Fluxo de decisão de acesso" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=17;fontStyle=1;fontColor=#17365D;" parent="v1" vertex="1">
                    <mxGeometry x="90" y="795" width="300" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="vf1" value="Requisição protegida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=13;" parent="v1" vertex="1">
